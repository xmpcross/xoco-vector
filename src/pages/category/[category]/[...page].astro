---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryLayouts, categoryMeta } from "@/config/categories";
import {
  categories,
  categoryFromSlug,
  categorySlug,
  formatDate,
  getByCategory,
  visiblePosts,
  type Category,
  type Post,
} from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = visiblePosts(await getCollection("posts"));

  return categories.flatMap((category) => {
    const posts = getByCategory(allPosts, category);

    return paginate(posts, {
      pageSize: 12,
      params: { category: categorySlug(category) },
      props: { category, allPosts },
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
  allPosts: Post[];
  page: Page<Post>;
}

const { category, allPosts, page } = Astro.props;
const categoryFromUrl = categoryFromSlug(Astro.params.category ?? "");
const cat = categoryFromUrl ?? category;
const posts = page.data;
const allCategoryPosts = getByCategory(allPosts, cat);
const layout = categoryLayouts[cat];
const lead = layout === "featured" && page.currentPage === 1 ? posts[0] : undefined;
const remainingPosts = lead ? posts.slice(1) : posts;
const sideRail = visiblePosts(allPosts).filter((post) => post.data.category !== cat).slice(0, 5);
const title = page.currentPage === 1 ? `${cat} posts` : `${cat} posts - Page ${page.currentPage}`;
const description = categoryMeta[cat].description;
const withTrailingSlash = (url: string | undefined) =>
  url && !url.endsWith("/") ? `${url}/` : url;
const prevUrl = withTrailingSlash(page.url.prev);
const nextUrl = withTrailingSlash(page.url.next);
---

<BaseLayout title={title} description={description} prevUrl={prevUrl} nextUrl={nextUrl}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen">
    <section class="mx-auto layout-wide px-5 pt-12 lg:px-8">
      <div class="pb-5">
        <div>
          <p class="eyebrow">Category</p>
          <h1 class="mt-2 text-5xl font-bold tracking-tight md:text-6xl">{cat}</h1>
          <p class="mt-4 max-w-2xl text-muted-foreground">
            {description}
          </p>
          <p class="mt-3 text-[12px] font-semibold text-muted-foreground">
            Page {page.currentPage} of {page.lastPage} &middot; {page.total} {page.total === 1 ? "post" : "posts"}
            {allCategoryPosts[0] && (
              <>
                {" "}&middot; Latest <time datetime={allCategoryPosts[0].data.date.toISOString()}>{formatDate(allCategoryPosts[0].data.date)}</time>
              </>
            )}
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto layout-wide px-5 pt-10 lg:px-8">
      <div class="grid items-start gap-8 lg:grid-cols-[1fr_340px]">
        <div class="min-w-0">
          {layout === "timeline" && (
            <div class="grid pl-1">
              {posts.map((post) => <PostCard post={post} variant="changelog" />)}
              {posts.length === 0 && <p class="text-muted-foreground">More updates are coming soon.</p>}
            </div>
          )}

          {layout === "featured" && (
            <div class="space-y-8">
              {lead && <PostCard post={lead} variant="hero" eager />}
              <div class="grid items-start gap-6 md:grid-cols-2">
                {remainingPosts.map((post, index) => (
                  <PostCard
                    post={post}
                    variant="medium"
                    headingLevel="h2"
                    eager={page.currentPage === 1 && !lead && index < 2}
                  />
                ))}
              </div>
              {posts.length === 0 && <p class="text-muted-foreground">More posts are coming soon.</p>}
            </div>
          )}

          {layout === "grid" && (
            <div class="grid items-start gap-6 md:grid-cols-2">
              {posts.map((post, index) => (
                <PostCard
                  post={post}
                  variant="medium"
                  headingLevel="h2"
                  eager={page.currentPage === 1 && index < 2}
                />
              ))}
              {posts.length === 0 && <p class="text-muted-foreground">More posts are coming soon.</p>}
            </div>
          )}

          {layout === "list" && (
            <div class="grid">
              {posts.map((post) => <PostCard post={post} variant="list" headingLevel="h2" />)}
              {posts.length === 0 && <p class="text-muted-foreground">More posts are coming soon.</p>}
            </div>
          )}
        </div>
        <aside aria-labelledby="across-site-heading">
          <div class="sticky top-24">
            <div class="mb-4 flex items-center justify-between pb-3">
              <h2 id="across-site-heading" class="text-lg font-bold tracking-tight">Elsewhere on the site</h2>
            </div>
            {sideRail.map((post) => <PostCard post={post} variant="horizontal" />)}
          </div>
        </aside>
      </div>

      <nav class="mt-12 flex flex-wrap items-center justify-between gap-4 pt-6" aria-label={`${cat} pagination`}>
        {
          page.url.prev ? (
            <a href={page.url.prev} class="story-link text-[13px] font-semibold text-muted-foreground hover:text-accent">
              Previous
            </a>
          ) : (
            <span class="text-[13px] font-semibold text-muted-foreground/50">Previous</span>
          )
        }
        <span class="text-[13px] font-semibold text-muted-foreground">
          Page {page.currentPage} / {page.lastPage}
        </span>
        {
          page.url.next ? (
            <a href={page.url.next} class="story-link text-[13px] font-semibold text-muted-foreground hover:text-accent">
              Next
            </a>
          ) : (
            <span class="text-[13px] font-semibold text-muted-foreground/50">Next</span>
          )
        }
      </nav>
    </section>

    <section class="mx-auto layout-wide px-5 pt-24 lg:px-8">
      <NewsletterSignup />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
