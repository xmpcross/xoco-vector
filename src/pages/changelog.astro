---
import { getCollection } from "astro:content";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { formatDate, postHref, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const releases = allPosts.filter((post) => Boolean(post.data.release));
const releasesByYear = releases.reduce<Record<string, typeof releases>>((groups, post) => {
  const year = String(post.data.date.getFullYear());
  groups[year] = [...(groups[year] ?? []), post];
  return groups;
}, {});
const years = Object.keys(releasesByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Changelog"
  description={`Product updates, release notes, and migration notes from ${siteConfig.name}.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen">
    <section class="mx-auto layout-wide px-5 pt-12 lg:px-8">
      <div class="border-b border-border pb-6">
        <p class="eyebrow">Changelog</p>
        <h1 class="mt-2 max-w-3xl text-[clamp(2.2rem,6vw,4.5rem)] font-bold leading-none tracking-tight text-balance">
          Product updates with the details teams need.
        </h1>
        <p class="mt-5 max-w-2xl text-pretty text-lg leading-8 text-muted-foreground">
          A release timeline for notable changes, migration notes, and operational improvements.
        </p>
      </div>
    </section>

    <section class="mx-auto layout-wide px-5 pt-10 lg:px-8">
      <div class="max-w-4xl">
        {
          years.map((year) => (
            <section class="reveal grid gap-5 border-b border-border py-8 last:border-b-0 md:grid-cols-[8rem_minmax(0,1fr)]" aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`} class="text-2xl font-bold tracking-tight">{year}</h2>
              <div class="grid pl-1">
                {releasesByYear[year].map((post) => {
                  const version = post.data.release?.version ?? post.data.title.match(/^v\d[\d.]*/)?.[0];
                  const title = version ? post.data.title.replace(/^v\d[\d.]*:\s*/, "") : post.data.title;

                  return (
                    <article class="relative border-l-2 border-border pb-8 pl-7 last:pb-0">
                      <span class="absolute -left-[5px] top-2 h-2 w-2 bg-accent" aria-hidden="true" />
                      <div class="flex flex-wrap items-center gap-2.5">
                        {version && <span class="version-chip">{version}</span>}
                        {post.data.release?.type && <span class="chip chip-neutral">{post.data.release.type}</span>}
                        <time class="text-[12px] text-muted-foreground" datetime={post.data.date.toISOString()}>
                          {formatDate(post.data.date)}
                        </time>
                      </div>
                      <h3 class="mt-3 text-xl font-bold leading-snug tracking-tight">
                        <a href={postHref(post)} class="headline-accent transition-colors">{title}</a>
                      </h3>
                      <p class="mt-2 text-pretty text-sm leading-6 text-muted-foreground">{post.data.excerpt}</p>
                    </article>
                  );
                })}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <section class="reveal mx-auto layout-wide px-5 pt-[var(--space-section)] lg:px-8">
      <NewsletterSignup />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
