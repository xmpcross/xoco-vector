---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const contact = siteConfig.contact;
const contactAction = contact.action.trim();
const isContactConfigured = contact.enabled && contactAction.length > 0;
---

<BaseLayout title="Contact" description={`Contact ${siteConfig.name} for editorial, advertising, partnerships, and general publication inquiries.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="pb-16">
    <section class="mx-auto max-w-5xl px-6 pt-10 lg:px-10">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 text-[clamp(2.4rem,6vw,4.25rem)] font-bold leading-none tracking-tight text-balance">
        Get in touch
      </h1>
      <p class="mt-5 max-w-2xl text-pretty text-lg leading-8 text-muted-foreground">
        Send editorial notes, advertising questions, partnership requests, or theme feedback.
      </p>
    </section>

    <section class="mx-auto grid max-w-5xl gap-8 px-6 pt-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)] lg:px-10">
      <form
        class="panel grid gap-5 p-6 md:p-8"
        action={isContactConfigured ? contactAction : undefined}
        method={contact.method}
        aria-describedby={!isContactConfigured ? "contact-configuration-note" : undefined}
      >
        <div>
          <h2 class="text-2xl font-bold tracking-tight">Send a message</h2>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            Share the context, timeline, and best way to reach you.
          </p>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required disabled={!isContactConfigured} class="contact-field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required disabled={!isContactConfigured} class="contact-field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-topic">Topic</label>
          <select id="contact-topic" name="topic" required disabled={!isContactConfigured} class="contact-field">
            <option value="">Choose a topic</option>
            <option>Editorial inquiry</option>
            <option>Advertising</option>
            <option>Partnership</option>
            <option>Theme support</option>
          </select>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="6" required disabled={!isContactConfigured} class="contact-field resize-y"></textarea>
        </div>

        <button type="submit" disabled={!isContactConfigured} class="inline-flex min-h-12 w-fit items-center rounded-md bg-primary px-6 py-3 text-sm font-bold text-primary-foreground transition-opacity hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-60">
          {isContactConfigured ? "Send message" : "Form unavailable"}
        </button>
        {!isContactConfigured && (
          <p id="contact-configuration-note" class="text-sm leading-6 text-muted-foreground">
            This demo form is disabled until a form endpoint is configured.
          </p>
        )}
      </form>

      <aside class="content-start">
        <section aria-labelledby="contact-details-heading">
          <h2 id="contact-details-heading" class="text-xl font-bold tracking-tight">Contact details</h2>
          <dl class="mt-5 grid gap-4 text-sm">
            {siteConfig.email && (
              <div>
                <dt class="font-semibold text-foreground">Editorial</dt>
                <dd class="mt-1 text-muted-foreground">
                  <a class="story-link text-accent" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
                </dd>
              </div>
            )}
            {contact.office.length > 0 && (
              <div>
              <dt class="font-semibold text-foreground">Office</dt>
              <dd class="mt-1 leading-6 text-muted-foreground">
                  {contact.office.map((line) => <span class="block">{line}</span>)}
              </dd>
              </div>
            )}
            {contact.responseTime && (
              <div>
              <dt class="font-semibold text-foreground">Response time</dt>
                <dd class="mt-1 text-muted-foreground">{contact.responseTime}</dd>
              </div>
            )}
          </dl>
          {!siteConfig.email && contact.office.length === 0 && !contact.responseTime && (
            <p class="mt-5 text-sm leading-6 text-muted-foreground">
              Add publication contact details in the central site configuration before publishing.
            </p>
          )}
        </section>
      </aside>
    </section>
  </main>
  <SiteFooter />

  <style>
    .contact-field {
      min-height: 3rem;
      border: 1px solid var(--border);
      background: var(--background);
      color: var(--foreground);
      padding: 0.75rem 0.875rem;
      font: inherit;
      border-radius: var(--radius-sm);
    }

    .contact-field:focus {
      border-color: var(--accent);
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  </style>
</BaseLayout>
