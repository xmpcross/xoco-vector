---
import { getCollection } from "astro:content";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts, type Post } from "@/lib/posts";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  return getAllAuthors(allPosts).map((author) => ({
    params: { author: author.slug },
    props: { author, allPosts },
  }));
}

interface Props {
  author: {
    slug: string;
    name: string;
    role: string;
    posts: Post[];
  };
  allPosts: Post[];
}

const { author, allPosts } = Astro.props;
const posts = visiblePosts(allPosts).filter((post) => authorSlug(post.data.author.name) === author.slug);
const title = `${author.name} articles`;
const description = `Articles by ${author.name}, ${author.role}, on ${siteConfig.name}.`;
---

<BaseLayout title={title} description={description}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen">
    <section class="mx-auto layout-wide px-5 pt-12 lg:px-8">
      <div class="border-b border-border pb-6">
        <p class="eyebrow">Author</p>
        <div class="mt-4 flex flex-wrap items-start gap-5">
          <div class="grid h-16 w-16 place-items-center rounded-full bg-primary text-2xl font-bold text-primary-foreground" aria-hidden="true">
            {author.name.charAt(0)}
          </div>
          <div>
            <h1 class="text-[clamp(2.2rem,6vw,4rem)] font-bold leading-none tracking-tight">{author.name}</h1>
            <p class="mt-2 text-muted-foreground">{author.role}</p>
          </div>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-6 text-muted-foreground">
          {posts.length} {posts.length === 1 ? "article" : "articles"} by {author.name}.
        </p>
      </div>
    </section>

    <section class="mx-auto layout-wide px-5 pt-10 lg:px-8">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => <PostCard post={post} variant="lead" eager={index < 2} />)}
      </div>
    </section>

    <section class="mx-auto layout-wide px-5 pt-[var(--space-section)] lg:px-8">
      <NewsletterSignup />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
