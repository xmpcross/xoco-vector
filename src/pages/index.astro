---
import { getCollection } from "astro:content";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostCard from "@/components/PostCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryMeta, releaseCategory } from "@/config/categories";
import { siteConfig } from "@/config/site";
import { categories, categorySlug, excludePosts, formatDate, getByCategory, getTrending, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const updates = allPosts.filter((post) => Boolean(post.data.release)).slice(0, 4);
const articles = excludePosts(allPosts, updates);
const featured = articles[0];
const latest = articles.slice(1, 9);
const trending = getTrending(articles, 5);
const deepDives = getByCategory(allPosts, "Engineering")
  .filter((post) => post.id !== featured?.id)
  .slice(0, 6);
const topicRails = categories
  .filter((category) => category !== releaseCategory)
  .map((category) => ({
    category,
    count: getByCategory(allPosts, category).length,
    description: categoryMeta[category].description,
    latestDate: getByCategory(allPosts, category)[0]?.data.date,
  }))
  .filter((rail) => rail.count > 0);
---

<BaseLayout>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen">
    <h1 class="sr-only">{siteConfig.name} - Tech blog, tutorials, and product updates</h1>

    <section class="mx-auto layout-wide px-5 pt-12 lg:px-8">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4 border-b border-border pb-4">
        <div>
          <p class="eyebrow">Featured</p>
          <p class="mt-2 max-w-2xl text-2xl font-bold leading-snug tracking-tight text-balance md:text-3xl">
            {siteConfig.tagline}
          </p>
        </div>
        <a href="/posts/" class="pb-1 text-[13px] font-semibold text-accent transition-colors hover:text-accent-strong">
          Browse archive
        </a>
      </div>
      {featured && <PostCard post={featured} variant="hero" eager />}
    </section>

    <section class="mx-auto layout-wide px-5 pt-[var(--space-section)] lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div>
          <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2 border-b border-border pb-3">
            <div>
              <p class="eyebrow">Writing</p>
              <h2 class="mt-1 text-2xl font-bold tracking-tight md:text-[1.7rem]">Latest posts</h2>
            </div>
            <a href="/posts/" class="pb-1 text-[13px] font-semibold text-accent transition-colors hover:text-accent-strong">
              View all
            </a>
          </div>
          <div class="grid">
            {latest.map((post) => <PostCard post={post} variant="row" />)}
          </div>
        </div>

        <div class="space-y-10 self-start lg:sticky lg:top-24">
          <aside aria-labelledby="updates-heading" class="feature-card p-5">
            <div class="mb-5 flex items-baseline justify-between gap-4">
              <h2 id="updates-heading" class="text-lg font-bold tracking-tight">Changelog</h2>
              <a href="/changelog/" class="text-[12px] font-semibold text-accent transition-colors hover:text-accent-strong">
                All releases
              </a>
            </div>
            <div class="grid pl-1">
              {updates.map((post) => <PostCard post={post} variant="changelog" />)}
            </div>
          </aside>

          <aside aria-labelledby="most-read-heading">
            <h2 id="most-read-heading" class="border-b border-border pb-3 text-lg font-bold tracking-tight">Most read</h2>
            <div class="grid">
              {trending.map((post, index) => <PostCard post={post} variant="ranked" rank={index + 1} />)}
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="reveal section-separator mx-auto layout-wide mt-[var(--space-section)] px-5 pt-[var(--space-section)] lg:px-8">
      <div class="mb-7 border-b border-border pb-3">
        <p class="eyebrow">Browse</p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight md:text-[1.7rem]">Topics</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {
          topicRails.map(({ category, count, description, latestDate }) => (
            <a
              href={`/category/${categorySlug(category)}/`}
              aria-labelledby={`topic-${categorySlug(category)}`}
              class="panel card-lift group block min-w-0 p-5"
            >
              <div class="flex items-baseline justify-between gap-3">
                <h3 id={`topic-${categorySlug(category)}`} class="text-base font-bold tracking-tight">
                  <span class="headline-accent transition-colors">{category}</span>
                </h3>
                <span class="chip chip-neutral">{count} posts</span>
              </div>
              <div class="mt-3 border-t border-border pt-3">
                <p class="text-pretty text-sm leading-6 text-muted-foreground">{description}</p>
                {latestDate && (
                  <p class="mt-4 text-[12px] font-semibold text-muted-foreground">
                    Latest: <time datetime={latestDate.toISOString()}>{formatDate(latestDate)}</time>
                  </p>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="reveal section-separator mx-auto layout-wide mt-[var(--space-section)] px-5 pt-[var(--space-section)] lg:px-8">
      <SectionHeader title="Deep Dives" category="Engineering" />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {deepDives.map((post, index) => <PostCard post={post} variant={index < 3 ? "lead" : "medium"} />)}
      </div>
    </section>

    <section class="reveal mx-auto layout-wide px-5 pt-[var(--space-section)] lg:px-8">
      <NewsletterSignup />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
