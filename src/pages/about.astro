---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import aboutPhoto from "@/assets/images/about.jpg";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="About" description={`Learn about ${siteConfig.name}, who writes it, and the kind of writing readers can expect.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen pb-16">
    <section class="mx-auto max-w-4xl px-6 pt-12 lg:px-10">
      <p class="eyebrow">About</p>
      <h1 class="mt-3 text-5xl font-bold tracking-tight md:text-6xl">{siteConfig.name}</h1>
      <p class="mt-6 max-w-2xl text-pretty text-xl text-muted-foreground">
        {siteConfig.description}
      </p>
    </section>

    <section class="mx-auto grid max-w-4xl gap-10 px-6 pt-14 lg:px-10">
      <div class="border-t border-border pt-8">
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">What we write about</h2>
        <p class="mt-4 text-pretty leading-7 text-muted-foreground">
          {siteConfig.name} covers the practice of building software: architecture decisions, tooling, performance work, postmortems, and the product updates behind each release.
        </p>
      </div>

      <div class="border-t border-border pt-8">
        <h2 class="text-2xl font-bold tracking-tight md:text-3xl">How we write it</h2>
        <p class="mt-4 text-pretty leading-7 text-muted-foreground">
          Posts should be reproducible, honest about trade-offs, and specific enough to act on. Release notes say what changed, what broke, and how to migrate.
        </p>
      </div>
    </section>

    <figure class="mx-auto layout-wide px-5 pt-16 lg:px-8">
      <div class="relative aspect-4/3 overflow-hidden rounded-xl sm:aspect-video lg:aspect-21/9">
        <Image
          src={aboutPhoto}
          alt="Four colleagues talking around a table of laptops in a bright office"
          widths={[640, 960, 1400, 2000]}
          sizes="(min-width: 76rem) 76rem, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
      <figcaption class="mt-3 text-[11px] text-muted-foreground">
        Photo: <a href="https://www.pexels.com/photo/7550538/" rel="noreferrer" class="underline decoration-border underline-offset-2 transition-colors hover:text-accent">MART PRODUCTION / Pexels</a>
      </figcaption>
    </figure>
  </main>
  <SiteFooter />
</BaseLayout>

