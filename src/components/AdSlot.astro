---
import { siteConfig } from "@/config/site";

interface Props {
  label?: string;
}

const { label = siteConfig.adLabel } = Astro.props;
---

<aside class="grid min-h-48 place-items-center rounded-lg border border-dashed border-border bg-muted/40 p-6 text-center">
  <div>
    <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-muted-foreground">Advertisement</p>
    <p class="mt-3 text-xl font-bold">{label}</p>
  </div>
</aside>
