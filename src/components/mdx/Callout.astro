---
interface Props {
  type?: "note" | "tip" | "warning" | "danger";
  title?: string;
}

const { type = "note", title } = Astro.props;

const defaultTitles: Record<NonNullable<Props["type"]>, string> = {
  note: "Note",
  tip: "Tip",
  warning: "Warning",
  danger: "Important",
};

const heading = title ?? defaultTitles[type];
---

<aside class:list={["callout", `callout-${type}`]} aria-label={heading}>
  <p class="callout-title">{heading}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 1.75rem 0;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--background-wash));
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  .callout-tip {
    border-left-color: var(--tip);
    background: color-mix(in srgb, var(--tip) 8%, var(--background-wash));
  }

  .callout-warning {
    border-left-color: var(--warning);
    background: color-mix(in srgb, var(--warning) 8%, var(--background-wash));
  }

  .callout-danger {
    border-left-color: var(--danger);
    background: color-mix(in srgb, var(--danger) 10%, var(--background-wash));
  }

  /*
   * !important throughout: a Callout can land inside `.article-body`, whose
   * broad `:global(p)`/`:global(a)`/`:global(code)` rules in [slug].astro
   * out-specificity these scoped selectors and otherwise bleed through,
   * making the title render as a plain paragraph instead of a label.
   */
  .callout-title {
    margin: 0 0 0.4rem !important;
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    line-height: 1.4 !important;
    color: var(--accent) !important;
  }

  .callout-tip .callout-title {
    color: var(--tip) !important;
  }

  .callout-warning .callout-title {
    color: var(--warning) !important;
  }

  .callout-danger .callout-title {
    color: var(--danger) !important;
  }

  .callout-body {
    font-size: 1rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--foreground) 92%, transparent);
  }

  .callout-body :global(p) {
    margin: 0.5rem 0 0 !important;
    font-size: 1rem !important;
    line-height: 1.7 !important;
    color: inherit !important;
  }

  .callout-body :global(p:first-child) {
    margin-top: 0 !important;
  }

  .callout-body :global(a) {
    color: inherit !important;
    text-decoration: underline !important;
    text-decoration-color: currentColor !important;
    text-underline-offset: 0.2em !important;
  }

  .callout-body :global(code) {
    background: var(--muted) !important;
    padding: 0.15rem 0.4rem !important;
    font-family: var(--font-mono) !important;
    font-size: 0.9em !important;
    border-radius: var(--radius-xs) !important;
  }
</style>
