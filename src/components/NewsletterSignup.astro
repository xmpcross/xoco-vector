---
import { siteConfig } from "@/config/site";

const newsletter = siteConfig.newsletter;
const action = newsletter.action.trim();
const isConfigured = newsletter.enabled && action.length > 0;
const method = newsletter.method || "post";
const emailFieldName = newsletter.emailFieldName || "email";
---

<section id="newsletter" class="feature-card px-5 py-8 md:px-8 md:py-10">
  <div class="grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-center">
    <div>
      <p class="eyebrow">{newsletter.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold leading-[1.08] tracking-tight text-balance md:text-4xl">
        {newsletter.title}
      </h2>
    </div>
    <form
      class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto]"
      action={isConfigured ? action : undefined}
      method={method}
      aria-describedby={!isConfigured ? "newsletter-configuration-note" : undefined}
    >
      <p class="text-pretty leading-7 text-muted-foreground sm:col-span-2">
        {newsletter.description}
      </p>
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        required
        type="email"
        name={emailFieldName}
        autocomplete="email"
        placeholder="you@example.com"
        disabled={!isConfigured}
        class="min-h-12 rounded-md border border-border bg-background px-4 py-3 text-sm placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-60"
      />
      <button
        type="submit"
        disabled={!isConfigured}
        class="min-h-12 rounded-md bg-primary px-7 py-3 text-sm font-bold text-primary-foreground transition-opacity hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-60"
      >
        {isConfigured ? "Subscribe" : "Coming soon"}
      </button>
      {!isConfigured && (
        <p id="newsletter-configuration-note" class="text-xs text-muted-foreground sm:col-span-2">
          Newsletter signup is disabled until a provider is configured.
        </p>
      )}
    </form>
  </div>
</section>
